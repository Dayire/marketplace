{
  "name": "marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm sdk:build && next dev",
    "dev:https": "pnpm sdk:build && node scripts/dev/dev-https.mjs",
    "build": "pnpm sdk:build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm sdk:build && tsc --noEmit",
    "test": "pnpm sdk:build && vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "pnpm sdk:build && vitest run --project unit --project storybook --coverage",
    "test:e2e": "playwright test",
    "test:e2e:screenshots": "playwright test tests/e2e/feature-screenshots.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "ci:feature-routes": "node scripts/ci/feature-screenshot-routes.mjs",
    "backend:test": "node --test services/marketplace-backend/test/*.test.mjs",
    "backend:dev": "node services/marketplace-backend/src/server.mjs",
    "backend:demo": "node services/marketplace-backend/src/demo.mjs",
    "contracts:test": "node scripts/contracts/test.mjs",
    "contracts:build": "cd contracts/marketplace && scarb build",
    "backend:index": "node services/marketplace-backend/src/worker.mjs index",
    "backend:discover": "node services/marketplace-backend/src/worker.mjs discover",
    "backend:bench:acquisition": "node services/marketplace-backend/bench/shared-acquisition.mjs",
  "backend:bench:discovery": "node services/marketplace-backend/bench/discovery.mjs",
    "backend:metadata": "node services/marketplace-backend/src/worker.mjs metadata",
    "contracts:devnet": "pnpm sdk:build && node scripts/contracts/devnet.mjs",
    "contracts:abi": "pnpm contracts:build && node scripts/contracts/export-abi.mjs",
    "storybook": "pnpm sdk:build && storybook dev -p 6006",
    "storybook:build": "pnpm sdk:build && storybook build",
    "storybook:test": "pnpm sdk:build && vitest run --project storybook",
    "storybook:test:watch": "vitest --project storybook",
    "sdk:build": "node scripts/packages/build.mjs",
    "sdk:test": "pnpm sdk:build && node --test packages/marketplace-sdk/test/*.test.mjs packages/marketplace-react/test/*.test.mjs",
    "sdk:pack:test": "node scripts/packages/verify-pack.mjs",
    "sdk:watch": "pnpm --parallel --filter @biblio/marketplace --filter @biblio/marketplace-react exec tsc -p tsconfig.json --watch",
    "release:check": "node scripts/release/check.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "release:audit": "pnpm audit --prod --audit-level=high",
    "contracts:deploy": "node scripts/deployment/cli.mjs",
    "contracts:deploy:test": "vitest run --project unit scripts/deployment/*.test.mjs",
    "contracts:deploy:rehearse": "node scripts/deployment/rehearse.mjs",
    "railway:check": "node --experimental-strip-types scripts/railway/check.mjs",
    "contracts:env": "node scripts/deployment/configure-env.mjs",
    "railway:variable": "node scripts/railway/set-variable.mjs",
    "railway:edge": "node scripts/railway/edge-rules.mjs",
    "backend:pg:test": "node --test services/marketplace-backend/test/postgres/*.test.mjs",
    "backend:pg": "node services/marketplace-backend/src/postgres/cli.mjs"
  },
  "dependencies": {
    "@biblio/marketplace": "workspace:*",
    "@biblio/marketplace-react": "workspace:*",
    "@cartridge/connector": "^0.13.9",
    "@cartridge/controller": "^0.13.9",
    "@starknet-react/chains": "^5.0.3",
    "@starknet-react/core": "^5.0.3",
    "@tanstack/react-query": "^5.90.21",
    "animejs": "^4.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "get-starknet-core": ">=4.0.0 <5.0.0-0",
    "lucide-react": "^0.569.0",
    "next": "16.3.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "starknet": "8.5.4",
    "tailwind-merge": "^3.4.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/runner": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^24.1.3",
    "msw": "^2.12.10",
    "playwright": "^1.58.2",
    "railway": "3.13.0",
    "shadcn": "^3.8.5",
    "starknet-devnet-sdk": "npm:starknet@10.8.0",
    "storybook": "10.6.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.23.3 <23"
  }
}
